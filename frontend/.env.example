# Copy to frontend/.env (gitignored). Names only: never commit real values.

# Base URL of the FastAPI backend (the app calls ${REACT_APP_BACKEND_URL}/api/...).
REACT_APP_BACKEND_URL=http://localhost:8001

# Optional dev-server toggles read by craco.config.js
# ENABLE_HEALTH_CHECK=true
# DISABLE_VISUAL_EDITS=true
