# Copy to backend/.env (gitignored) and fill in. Names only: never commit real values.
# server.py loads backend/.env on startup.

# Required: the server refuses to start without these.
MONGO_URL=mongodb://localhost:27017
DB_NAME=pentestai
# Long random string used to sign login JWTs (e.g. `openssl rand -hex 32`).
JWT_SECRET=

# Optional
# Comma-separated allowed origins for the API (defaults to "*").
CORS_ORIGINS=http://localhost:3000
# AI assistant, scan summaries and remediation (Emergent universal LLM key).
EMERGENT_LLM_KEY=
# Shodan lookups; the Shodan features report "not configured" without it.
SHODAN_API_KEY=
# NVD CVE enrichment: raises the rate limit from 5 to 50 requests / 30s.
NVD_API_KEY=
# Set to 1/true to turn off NVD CVE enrichment entirely.
NVD_ENRICHMENT_DISABLED=
# Set to 1/true to skip starting the scheduled-scan scheduler (tests, one-off runs).
PENTESTAI_DISABLE_SCHEDULER=
